{
  "extends": "@pkg/tsconfig/library.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "outDir": "./dist",
    "rootDir": ".",
    "resolveJsonModule": true,
    "lib": [
      "ESNext"
    ]
  },
  "include": [
    "src",
    "__tests__"
  ],
  "exclude": [
    "dist"
  ]
}
