{
  "extends": "./base.json",
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    // NodeNext resolution. The apps have no "type": "module", so their files
    // are CommonJS-format: relative imports need no extension, and imports of
    // ESM-only packages (NestJS 12) compile to require(esm), which Node 26
    // supports. The shared packages ARE ESM, hence their .js suffixes.
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "declaration": true,
    "noEmit": false,
    "outDir": "./dist",
    "verbatimModuleSyntax": false
  }
}
