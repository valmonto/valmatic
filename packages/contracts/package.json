{
  "name": "@pkg/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./client": {
      "types": "./src/client/index.ts",
      "import": "./dist/client/index.mjs",
      "require": "./dist/client/index.cjs"
    },
    "./types": {
      "types": "./src/types/index.ts",
      "import": "./dist/types/index.mjs",
      "require": "./dist/types/index.cjs"
    },
    "./schemas": {
      "types": "./src/schemas/index.ts",
      "import": "./dist/schemas/index.mjs",
      "require": "./dist/schemas/index.cjs"
    },
    "./constants": {
      "types": "./src/constants/index.ts",
      "import": "./dist/constants/index.mjs",
      "require": "./dist/constants/index.cjs"
    },
    "./permissions": {
      "types": "./src/permissions/index.ts",
      "import": "./dist/permissions/index.mjs",
      "require": "./dist/permissions/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@pkg/tsconfig": "workspace:*",
    "@pkg/eslint-config": "workspace:*",
    "typescript": "catalog:",
    "eslint": "catalog:",
    "tsdown": "catalog:",
    "@pkg/vitest-config": "workspace:*",
    "vitest": "catalog:"
  }
}
