# Local dev with `docker compose -f compose.dev.yml up` (Postgres, Redis, rustfs).
# Usage: cp .env.example .env && source .env
# Everything else has a working dev default in apps/{api,worker}/src/config/env.schema.ts.

# Postgres from compose.dev.yml
export DATABASE_URL=postgresql://vboilerplate:vboilerplate@127.0.0.1:5432/vboilerplate

# Redis from compose.dev.yml (--requirepass vboilerplate); sessions and job queues
export IAM_REDIS_PASSWORD=vboilerplate
export REDIS_PASSWORD=vboilerplate

# Auth secrets — required, min 32 chars. Generate: openssl rand -hex 32
# Production refuses any value containing "change-me", and one value for both.
export IAM_JWT_SECRET=dev-jwt-secret-change-me-at-least-32-characters
export IAM_COOKIE_SECRET=dev-cookie-secret-change-me-at-least-32-characters

# Seed the first organization and its owner on boot (dev convenience).
export SEED_ON_STARTUP=true

# Account creation is closed by default; the web register page follows the API.
# export AUTH_REGISTRATION_ENABLED=true
# export VITE_PUBLIC_REGISTRATION_ENABLED=true

# Browser origins allowed to call the API, comma-separated. Unset → localhost
# and the LAN only (see apps/api/src/config/cors.ts).
# export CORS_ORIGINS=https://app.example.com

# Object storage — the rustfs block in compose.dev.yml already matches the
# schema defaults (http://localhost:9000, valmatic/valmatic), so these are only
# needed when you point at a different endpoint.
# export STORAGE_ENDPOINT=http://localhost:9000
# export STORAGE_ACCESS_KEY_ID=valmatic
# export STORAGE_SECRET_ACCESS_KEY=valmatic
# export STORAGE_BUCKET=valmatic-attachments

# Telemetry — optional, absent means no-op.
# export SENTRY_DSN=
# export POSTHOG_KEY=
# export VITE_PUBLIC_POSTHOG_KEY=

# Mobile (Expo) — the phone can't reach "localhost"; use this machine's LAN IP.
# Find it with: ip -4 -br addr show
export EXPO_PUBLIC_API_URL=http://YOUR_LAN_IP:3000
