# The app's front door, imported by Caddyfile (deployed) and e2e.Caddyfile.
#
#   /api*, /health*  → every api copy, load-balanced (see the reverse_proxy)
#   everything else  → the built web app in /srv
#
# Read caddy/README.md before changing it.

(app) {
	encode zstd gzip

	header {
		# Scripts run only from this address, so a script slipped into a page
		# does not run. Styles may be inline (component libraries write them).
		# Images and connections may reach https: — uploads go straight to the
		# storage bucket, and telemetry, when configured, to its own host.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https:; frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
		X-Frame-Options DENY
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	@api path /api /api/* /health /health/*
	handle @api {
		# The outer wall on the api alone; each route keeps its own, smaller
		# limit. 64 MB, as Specbook's ingress had.
		request_body {
			max_size 64MB
		}
		reverse_proxy {
			# Every api copy: Caddy asks Docker's DNS for all addresses of
			# `api` every 5 s, so `--scale api=N` and a redeploy are picked up
			# without a reload.
			dynamic a {$API_HOST:api} {$API_PORT:3000} {
				refresh 5s
			}
			lb_policy round_robin
			# During a deploy a copy disappears: try the others, and wait up
			# to 10 s for one to answer, instead of sending the visitor a 502.
			lb_try_duration 10s
			lb_try_interval 250ms
			# A copy that is gone leaves an address nobody answers on; on the
			# local network a live one connects in well under a millisecond.
			# Without this, each dead address costs 3 s of those 10.
			transport http {
				dial_timeout 1s
			}
			# A copy that refused a connection is skipped for 10 s.
			fail_duration 10s
			health_uri /health
			health_interval 5s
			health_timeout 3s
			# The visitor's address, for the api's per-address limits
			# (TRUST_PROXY=true reads it). {client_ip} is the peer, or what a
			# trusted proxy (GATEWAY_TRUSTED_PROXIES) said in X-Client-IP.
			# Replaced, not appended: a visitor cannot plant an address.
			header_up X-Forwarded-For {client_ip}
		}
	}

	handle {
		root * /srv

		# Vite names built files by content: a new build gets new names, so
		# these are kept for a year. Everything else (index.html above all) is
		# checked on every visit, so a deploy shows at once. Only a file that
		# exists: a 404 must not be kept for a year (a rollback can bring the
		# name back).
		@hashed {
			path /assets/*
			file
		}
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@unhashed not path /assets/*
		header @unhashed Cache-Control "no-cache"

		# A path that names a file (it has an extension) gets that file or a
		# real 404; any other path is a screen of the app and gets index.html.
		# (Answering a missing /assets/old.js with index.html and 200 makes a
		# browser holding a page from before a deploy run HTML as a script.)
		@screen not path_regexp \.[^/]+$
		rewrite @screen /index.html
		file_server
	}
}
